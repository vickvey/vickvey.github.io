---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../data/profile.json";
import pgp from "../data/pgp.json";
import { spellEmail } from "../lib/email";

// The served key file is the single source of truth for the key block
const keyBlock = readFileSync(join(process.cwd(), "public", pgp.file), "utf8").trim();

// Split into 4-character groups, two halves of five, as gpg prints it
const groups = pgp.fingerprint.match(/.{4}/g) ?? [];
const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const shortId = pgp.fingerprint.slice(-16);
---

<BaseLayout title="PGP Key" description={`OpenPGP public key for ${profile.name}.`}>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-semibold mb-2">PGP Key</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-10">
      Use this key to encrypt messages to me or verify things I've signed. Always check the fingerprint
      matches before trusting the key.
    </p>

    <div class="rounded-xl border dark:border-gray-800 bg-gray-50 dark:bg-gray-950 p-6 mb-8">
      <div class="flex items-center justify-between gap-4 mb-3">
        <h2 class="text-sm font-sans font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">
          Fingerprint
        </h2>
        <button
          type="button"
          data-copy={pgp.fingerprint}
          class="copy-btn text-sm px-3 py-1 rounded-md border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
        >
          Copy
        </button>
      </div>
      <p
        class="font-mono text-lg sm:text-xl tracking-wide grid grid-cols-5 gap-x-3 gap-y-1 w-fit"
        aria-label={`Fingerprint ${pgp.fingerprint}`}
      >
        {groups.map((g) => <span>{g}</span>)}
      </p>
    </div>

    <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 mb-10 text-sm">
      <dt class="text-gray-500 dark:text-gray-400">Owner</dt>
      <dd>{profile.name} &lt;{spellEmail(profile.email)}&gt;</dd>
      <dt class="text-gray-500 dark:text-gray-400">Key ID</dt>
      <dd class="font-mono">{shortId}</dd>
      <dt class="text-gray-500 dark:text-gray-400">Algorithm</dt>
      <dd>{pgp.algorithm}</dd>
      <dt class="text-gray-500 dark:text-gray-400">Created</dt>
      <dd><time datetime={pgp.created}>{fmt(pgp.created)}</time></dd>
      <dt class="text-gray-500 dark:text-gray-400">Expires</dt>
      <dd><time datetime={pgp.expires}>{fmt(pgp.expires)}</time></dd>
    </dl>

    <div class="flex flex-wrap gap-3 mb-10">
      <a
        href={pgp.file}
        download
        class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
      >
        Download public key
      </a>
      <button
        type="button"
        data-copy={keyBlock}
        class="copy-btn px-5 py-2.5 rounded-lg border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
      >
        Copy key block
      </button>
    </div>

    <p class="text-sm text-gray-600 dark:text-gray-400 mb-10">
      Also available on
      <a href={pgp.keyserver} class="underline hover:no-underline" rel="noopener">keys.openpgp.org</a>.
    </p>

    <h2 class="text-2xl font-semibold mb-3">Import</h2>
    <pre
      class="font-mono text-sm bg-gray-100 dark:bg-gray-900 rounded-lg p-4 mb-10 overflow-x-auto">curl -s https://vickvey.github.io{pgp.file} | gpg --import</pre>

    <details class="group">
      <summary class="cursor-pointer text-2xl font-serif font-semibold mb-3">Public key block</summary>
      <pre class="font-mono text-xs bg-gray-100 dark:bg-gray-900 rounded-lg p-4 overflow-x-auto">{keyBlock}</pre>
    </details>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.textContent = "Copied!";
      } catch {
        btn.textContent = "Copy failed";
      }
      setTimeout(() => (btn.textContent = label), 1500);
    });
  });
</script>
