---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, readingTime } from "../../lib/blog";

const posts = await getPosts();

// Lowercased plain text per post, matched against the search box in the browser
const searchText = (post: (typeof posts)[number]) =>
  [post.data.title, post.data.description, post.data.tags.join(" "), post.body ?? ""]
    .join(" ")
    .replace(/[`#*|>\[\]]/g, " ")
    .replace(/\s+/g, " ")
    .toLowerCase();
---

<BaseLayout title="Blog" description="Notes on data science, machine learning, remote sensing and quantitative finance.">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-semibold mb-2">Blog</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-12">
      Notes on data science, machine learning and quantitative finance.{" "}
      <a href="/rss.xml" class="text-blue-600 dark:text-blue-400 hover:underline">RSS</a>
    </p>

    {posts.length === 0 && <p class="text-gray-500 dark:text-gray-400">No posts yet — check back soon.</p>}

    {
      posts.length > 0 && (
        <div class="mb-10">
          <label for="blog-search" class="sr-only">Search posts</label>
          <div class="relative">
            <svg
              class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400 pointer-events-none"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              id="blog-search"
              type="search"
              autocomplete="off"
              placeholder="Search posts, tags, commands…"
              class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 pl-11 pr-14 py-3 text-base text-gray-900 dark:text-gray-100 placeholder:text-gray-500 dark:placeholder:text-gray-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30"
            />
            <kbd
              id="search-hint"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-xs px-2 py-0.5 rounded border border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400 font-mono pointer-events-none"
            >
              /
            </kbd>
          </div>
          <p id="search-status" class="text-sm text-gray-500 dark:text-gray-400 mt-3 min-h-5" aria-live="polite" />
        </div>
      )
    }

    <ul class="space-y-10" id="post-list">
      {
        posts.map((post) => (
          <li data-post data-search={searchText(post)}>
            <a href={`/blog/${post.id}/`} class="group block">
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                {" · "}{readingTime(post.body)} min read
                {import.meta.env.DEV && post.data.draft && <span class="ml-2 px-2 py-0.5 rounded bg-yellow-100 text-yellow-800 text-xs">draft</span>}
              </p>
              <h2 class="text-2xl font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {post.data.title}
              </h2>
              <p class="text-gray-600 dark:text-gray-400 mt-2">{post.data.description}</p>
            </a>
            {post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-3">
                {post.data.tags.map((t) => (
                  <button
                    type="button"
                    data-tag={t}
                    class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 dark:text-gray-300 rounded hover:bg-blue-100 dark:hover:bg-blue-900/40 hover:text-blue-700 dark:hover:text-blue-300 cursor-pointer transition-colors"
                  >
                    {t}
                  </button>
                ))}
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <p id="no-results" class="hidden text-gray-600 dark:text-gray-400">
      No posts match your search. Try fewer or different words.
    </p>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("#blog-search");
  const status = document.querySelector<HTMLElement>("#search-status");
  const hint = document.querySelector<HTMLElement>("#search-hint");
  const empty = document.querySelector<HTMLElement>("#no-results");
  const items = [...document.querySelectorAll<HTMLElement>("[data-post]")];

  function apply() {
    if (!input) return;
    const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const li of items) {
      const hay = li.dataset.search ?? "";
      const match = terms.every((t) => hay.includes(t));
      li.hidden = !match;
      if (match) shown++;
    }
    empty?.classList.toggle("hidden", shown > 0 || items.length === 0);
    if (status) {
      status.textContent = terms.length ? `${shown} of ${items.length} post${items.length === 1 ? "" : "s"}` : "";
    }
    if (hint) hint.hidden = input.value.length > 0;

    const url = new URL(location.href);
    if (terms.length) url.searchParams.set("q", input.value.trim());
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }

  if (input) {
    input.value = new URL(location.href).searchParams.get("q") ?? "";
    input.addEventListener("input", apply);
    apply();

    // "/" focuses the search box, Esc clears it
    document.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement;
      const typing = target.matches("input, textarea, [contenteditable]");
      if (e.key === "/" && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) {
        e.preventDefault();
        input.focus();
      } else if (e.key === "Escape" && document.activeElement === input) {
        input.value = "";
        apply();
      }
    });

    // Clicking a tag filters by it
    document.querySelectorAll<HTMLElement>("[data-tag]").forEach((btn) =>
      btn.addEventListener("click", () => {
        input.value = btn.dataset.tag ?? "";
        apply();
        input.focus();
      }),
    );
  }
</script>
