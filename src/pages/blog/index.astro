---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, readingTime } from "../../lib/blog";

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes on data science, machine learning, remote sensing and quantitative finance.">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-semibold mb-2">Blog</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-12">
      Notes on data science, machine learning and quantitative finance.
      <a href="/rss.xml" class="text-blue-600 dark:text-blue-400 hover:underline">RSS</a>
    </p>

    {posts.length === 0 && <p class="text-gray-500 dark:text-gray-400">No posts yet — check back soon.</p>}

    <ul class="space-y-10">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group block">
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                {" · "}{readingTime(post.body)} min read
                {import.meta.env.DEV && post.data.draft && <span class="ml-2 px-2 py-0.5 rounded bg-yellow-100 text-yellow-800 text-xs">draft</span>}
              </p>
              <h2 class="text-2xl font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {post.data.title}
              </h2>
              <p class="text-gray-600 dark:text-gray-400 mt-2">{post.data.description}</p>
            </a>
            {post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-3">
                {post.data.tags.map((t) => (
                  <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 dark:text-gray-300 rounded">{t}</span>
                ))}
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
