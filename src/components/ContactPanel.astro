---
import profile from "../data/profile.json";
import pgp from "../data/pgp.json";
import socials from "../data/socials.json";
import SocialIcon from "./SocialIcon.astro";
import { encodeEmail, spellEmail } from "../lib/email";

const email = encodeEmail(profile.email);
const keyId = pgp.fingerprint.slice(-8).replace(/^(.{4})/, "$1 ");
const row = "flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition";
---

<!-- Native popover: opens/closes (Esc, click outside) without JS; only email decoding and copy need it -->
<div
  id="contact-panel"
  popover
  class="m-auto w-[min(24rem,calc(100%-2rem))] rounded-xl border dark:border-gray-800 bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-200 p-6 shadow-xl backdrop:bg-black/40"
>
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-2xl font-semibold">Get in touch</h2>
    <button
      type="button"
      popovertarget="contact-panel"
      popovertargetaction="hide"
      aria-label="Close"
      class="w-8 h-8 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition"
    >
      ✕
    </button>
  </div>

  <ul class="space-y-1 mb-5">
    <li class="flex items-center gap-2">
      <a href="#" data-email={email} class:list={[row, "flex-1"]}>
        <span aria-hidden="true">✉️</span> Email
      </a>
      <button
        type="button"
        data-copy-email={email}
        class="text-sm px-3 py-1 rounded-md border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
      >
        Copy
      </button>
    </li>
    <noscript>
      <li class="px-3 pb-2 text-sm text-gray-500 dark:text-gray-400">{spellEmail(profile.email)}</li>
    </noscript>
    <li>
      <a href="/pgp/" class={row}>
        <span aria-hidden="true">🔑</span> PGP key
        <span class="ml-auto font-mono text-xs text-gray-500 dark:text-gray-400">{keyId}</span>
      </a>
    </li>
  </ul>

  <div class="flex flex-wrap gap-2 pt-4 border-t dark:border-gray-800">
    {
      socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener"
          aria-label={s.label}
          title={s.label}
          class="w-10 h-10 inline-flex items-center justify-center rounded-lg border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
        >
          <SocialIcon icon={s.icon} label={s.label} />
        </a>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(atob(btn.dataset.copyEmail ?? ""));
        btn.textContent = "Copied!";
      } catch {
        btn.textContent = "Copy failed";
      }
      setTimeout(() => (btn.textContent = label), 1500);
    });
  });
</script>
