---
import Section from "./Section.astro";
import education from "../data/education.json";
import { inline } from "../lib/inline";
---

<Section id="education" title="Education" width="4xl">
  <ol class="relative border-l border-gray-300 dark:border-gray-700">
    {
      education.map((e) => (
        <li class="mb-10 last:mb-0 ml-6">
          <span
            class:list={[
              "absolute w-3 h-3 rounded-full -left-1.5 mt-2",
              e.current ? "bg-blue-600 dark:bg-blue-500" : "bg-gray-400 dark:bg-gray-600",
            ]}
          />
          <h3 class="font-semibold">{e.degree}</h3>
          <p class="text-gray-500 dark:text-gray-400">
            {e.institution} • {e.period}
          </p>
          {e.note && <p class="text-gray-700 dark:text-gray-300 leading-relaxed mt-2" set:html={inline(e.note)} />}
        </li>
      ))
    }
  </ol>
</Section>
