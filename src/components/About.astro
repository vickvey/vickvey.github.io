---
import Section from "./Section.astro";
import about from "../data/about.json";
import { inline } from "../lib/inline";

const chip = {
  blue: "bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/40",
  green: "bg-green-50 dark:bg-green-950/40 text-green-700 dark:text-green-300 hover:bg-green-100 dark:hover:bg-green-900/40",
};
---

<Section id="about" title="About & Research Interests" alt>
  <div class="bg-white dark:bg-gray-900 p-8 rounded-xl shadow-sm hover:shadow-md transition">
    <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6" set:html={inline(about.intro)} />

    <div class="bg-blue-50 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900 rounded-lg p-5 mb-6">
      <p class="text-sm text-blue-700 dark:text-blue-300 font-medium mb-2">Research Focus</p>
      <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">{about.focus}</p>
    </div>

    <ul class="space-y-3 mb-8">
      {
        about.bullets.map((b) => (
          <li class="flex items-start space-x-3">
            <span class="mt-1.5 w-2 h-2 shrink-0 bg-blue-600 dark:bg-blue-500 rounded-full" />
            <span class="text-gray-600 dark:text-gray-400 text-sm">{b}</span>
          </li>
        ))
      }
    </ul>

    <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-8">{about.direction}</p>

    <div class="border-t border-gray-200 dark:border-gray-800 mb-6"></div>

    <h3 class="font-semibold mb-4 text-blue-600 dark:text-blue-400">Research Interests</h3>
    <ul class="flex flex-wrap gap-3">
      {
        about.interests.map((i) => (
          <li class={`px-4 py-1.5 rounded-full text-sm font-medium transition ${i.accent === "green" ? chip.green : chip.blue}`}>
            {i.label}
          </li>
        ))
      }
    </ul>
  </div>
</Section>
