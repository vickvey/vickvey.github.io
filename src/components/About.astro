---
import Section from "./Section.astro";
import about from "../data/about.json";
import { inline } from "../lib/inline";

const chip = {
  blue: "bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/40",
  green: "bg-green-50 dark:bg-green-950/40 text-green-700 dark:text-green-300 hover:bg-green-100 dark:hover:bg-green-900/40",
};
---

<Section id="about" title="About & Research Interests" alt>
  <div class="grid lg:grid-cols-5 gap-8 items-start">
    <div class="lg:col-span-3 bg-paper dark:bg-gray-900 p-6 sm:p-10 rounded-xl shadow-sm hover:shadow-md transition">
      <p class="text-gray-800 dark:text-gray-200 leading-loose mb-6" set:html={inline(about.intro)} />
      <p class="text-gray-800 dark:text-gray-200 leading-loose">{about.direction}</p>
    </div>

    <div class="lg:col-span-2 bg-paper dark:bg-gray-900 p-6 sm:p-10 rounded-xl shadow-sm hover:shadow-md transition">
      <div class="bg-blue-50 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900 rounded-lg p-5 mb-8">
        <p class="text-sm text-blue-700 dark:text-blue-300 font-medium mb-2">Research Focus</p>
        <p class="text-gray-800 dark:text-gray-200 leading-loose">{about.focus}</p>
      </div>

      <h3 class="font-semibold mb-4 text-blue-600 dark:text-blue-400">Research Interests</h3>
      <ul class="flex flex-wrap gap-3">
        {
          about.interests.map((i) => (
            <li class={`px-4 py-1.5 rounded-full text-sm font-medium transition ${i.accent === "green" ? chip.green : chip.blue}`}>
              {i.label}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
