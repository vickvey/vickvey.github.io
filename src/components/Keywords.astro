---
interface Props {
  items: string[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<div class:list={["flex flex-wrap gap-2", className]}>
  {
    items.map((k) => (
      <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-700 dark:text-gray-300 rounded">{k}</span>
    ))
  }
</div>
