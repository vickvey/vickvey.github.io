---
import profile from "../data/profile.json";
import socials from "../data/socials.json";
import links from "../data/nav.json";
import SocialIcon from "./SocialIcon.astro";
import NavIcon from "./NavIcon.astro";

const onBlog = Astro.url.pathname.startsWith("/blog");
---

<!-- Replaces the header on wide screens (xl+); Header.astro hides itself at the same breakpoint -->
<aside
  id="sidebar"
  class="hidden xl:flex fixed inset-y-0 left-0 z-40 w-64 sidebar-collapsed:w-16 flex-col overflow-x-hidden overflow-y-auto border-r dark:border-gray-800 bg-paper dark:bg-gray-900 px-6 sidebar-collapsed:px-3 py-10 transition-[width] duration-200 motion-reduce:transition-none"
>
  <div class="flex items-center justify-between gap-2 sidebar-collapsed:justify-center">
    <a href="/" class="text-2xl font-thin tracking-tight whitespace-nowrap sidebar-collapsed:hidden">{profile.name}</a>
    <button
      type="button"
      data-sidebar-toggle
      aria-controls="sidebar"
      aria-expanded="true"
      aria-label="Collapse sidebar"
      title="Collapse sidebar"
      class="inline-flex items-center justify-center w-9 h-9 shrink-0 rounded-lg text-gray-500 dark:text-gray-400 hover:text-gray-900 hover:bg-gray-100 dark:hover:text-gray-100 dark:hover:bg-gray-800 transition-colors"
    >
      <NavIcon icon="panel-left" class="w-5 h-5" />
    </button>
  </div>

  <nav class="mt-10 flex flex-col gap-1 text-sm font-medium" aria-label="Main">
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={l.href === "/blog/" && onBlog ? "page" : undefined}
          class="-mx-3 px-3 sidebar-collapsed:mx-0 sidebar-collapsed:px-0 sidebar-collapsed:justify-center py-2 flex items-center gap-3 rounded-lg text-gray-600 dark:text-gray-400 hover:text-gray-900 hover:bg-gray-100 dark:hover:text-gray-100 dark:hover:bg-gray-800 transition-colors [&[aria-current]]:text-blue-600 [&[aria-current]]:bg-blue-50 dark:[&[aria-current]]:text-blue-400 dark:[&[aria-current]]:bg-blue-950/50"
        >
          <NavIcon icon={l.icon} class="w-5 h-5 shrink-0" />
          <span class="whitespace-nowrap sidebar-collapsed:sr-only">{l.label}</span>
        </a>
      ))
    }
  </nav>

  <div class="mt-auto pt-10 space-y-5">
    <button
      type="button"
      popovertarget="contact-panel"
      aria-label="Contact"
      class="w-full px-4 sidebar-collapsed:px-0 py-2 text-sm flex items-center justify-center bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
    >
      <NavIcon icon="mail" class="hidden sidebar-collapsed:block w-5 h-5" />
      <span class="sidebar-collapsed:hidden">Contact</span>
    </button>

    <div class="flex items-center justify-between sidebar-collapsed:flex-col sidebar-collapsed:gap-4">
      <div class="flex items-center gap-4 sidebar-collapsed:flex-col">
        {
          socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener"
              aria-label={s.label}
              title={s.label}
              class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
            >
              <SocialIcon icon={s.icon} label={s.label} class="w-4 h-4" />
            </a>
          ))
        }
      </div>

      <button
        data-theme-toggle
        type="button"
        aria-label="Toggle dark mode"
        class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
      >
        <span class="dark:hidden" aria-hidden="true">🌙</span>
        <span class="hidden dark:inline" aria-hidden="true">☀️</span>
      </button>
    </div>
  </div>
</aside>

<script>
  // Collapse to an icon-only strip; the choice is restored before paint by an inline script in BaseLayout
  const sidebar = document.getElementById("sidebar");
  const toggle = document.querySelector<HTMLButtonElement>("[data-sidebar-toggle]");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("#sidebar nav a");

  const render = () => {
    const collapsed = document.documentElement.classList.contains("sidebar-collapsed");
    const label = collapsed ? "Expand sidebar" : "Collapse sidebar";
    toggle?.setAttribute("aria-expanded", String(!collapsed));
    toggle?.setAttribute("aria-label", label);
    toggle?.setAttribute("title", label);
    // Labels are hidden when collapsed, so show them as tooltips instead
    navLinks.forEach((a) => {
      const text = a.textContent?.trim();
      if (collapsed && text) a.title = text;
      else a.removeAttribute("title");
    });
  };

  toggle?.addEventListener("click", () => {
    const collapsed = document.documentElement.classList.toggle("sidebar-collapsed");
    try {
      localStorage.setItem("sidebar", collapsed ? "collapsed" : "expanded");
    } catch {}
    render();
  });
  if (sidebar) render();

  // Highlight the section currently crossing the middle of the viewport (home page only)
  const sectionLinks = document.querySelectorAll<HTMLAnchorElement>("#sidebar a[href^='/#']");
  const linkFor = new Map([...sectionLinks].map((a) => [a.hash.slice(1), a]));
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        sectionLinks.forEach((a) => a.removeAttribute("aria-current"));
        linkFor.get(e.target.id)?.setAttribute("aria-current", "location");
      }
    },
    { rootMargin: "-50% 0px -50% 0px" },
  );
  linkFor.forEach((_, id) => {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  });
</script>
