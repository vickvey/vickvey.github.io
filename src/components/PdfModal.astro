---

<dialog
  id="pdf-dialog"
  class="m-auto w-[95vw] h-[90vh] max-w-none max-h-none p-0 rounded-xl shadow-lg overflow-hidden bg-white dark:bg-gray-900 backdrop:bg-black/70"
>
  <div class="flex flex-col w-full h-full">
    <div class="flex items-center justify-end gap-3 px-3 py-2 border-b dark:border-gray-700 text-sm">
      <a
        id="pdf-newtab"
        href="#"
        target="_blank"
        rel="noopener"
        class="text-blue-600 dark:text-blue-400 hover:underline"
      >
        Open in new tab
      </a>
      <button
        id="pdf-close"
        type="button"
        aria-label="Close viewer"
        class="px-3 py-1 bg-gray-800 dark:bg-gray-700 text-white rounded hover:bg-gray-700 dark:hover:bg-gray-600"
      >
        ✕
      </button>
    </div>
    <iframe id="pdf-frame" title="Document viewer" class="w-full flex-1"></iframe>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("pdf-dialog") as HTMLDialogElement | null;
  const frame = document.getElementById("pdf-frame") as HTMLIFrameElement | null;
  const newTab = document.getElementById("pdf-newtab") as HTMLAnchorElement | null;

  // Any element with data-pdf="/pdfs/x.pdf" opens the viewer
  document.addEventListener("click", (e) => {
    const trigger = (e.target as Element).closest<HTMLElement>("[data-pdf]");
    if (!trigger || !dialog || !frame || !newTab) return;
    e.preventDefault();
    const url = trigger.dataset.pdf!;
    frame.src = url;
    newTab.href = url;
    dialog.showModal();
    document.body.classList.add("overflow-hidden");
  });

  const close = () => dialog?.close();
  document.getElementById("pdf-close")?.addEventListener("click", close);
  // Click on the backdrop (the dialog element itself) closes
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) close();
  });
  // Fires for Escape, the button and the backdrop alike
  dialog?.addEventListener("close", () => {
    if (frame) frame.src = "about:blank";
    document.body.classList.remove("overflow-hidden");
  });
</script>
