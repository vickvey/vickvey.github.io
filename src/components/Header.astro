---
import profile from "../data/profile.json";
import links from "../data/nav.json";
---

<!-- Hidden on wide screens (xl+), where Sidebar.astro takes over -->
<header
  class="xl:hidden fixed top-0 w-full bg-paper/90 dark:bg-gray-900/90 backdrop-blur border-b dark:border-gray-800 z-50"
>
  <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
    <a href="/" class="text-xl md:text-2xl font-thin tracking-tight">{profile.name}</a>

    <nav class="hidden lg:flex items-center space-x-8 text-sm font-medium" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center">
      <button
        type="button"
        popovertarget="contact-panel"
        class="hidden lg:inline-block px-4 py-2 mr-3 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
      >
        Contact
      </button>

      <button
        data-theme-toggle
        type="button"
        aria-label="Toggle dark mode"
        class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition"
      >
        <span class="dark:hidden" aria-hidden="true">🌙</span>
        <span class="hidden dark:inline" aria-hidden="true">☀️</span>
      </button>

      <button
        id="menu-btn"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden text-2xl ml-3"
      >
        ☰
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden px-6 pb-4 border-t dark:border-gray-800">
    <div class="flex flex-col space-y-4 text-sm font-medium pt-4">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <button
        type="button"
        popovertarget="contact-panel"
        class="mt-2 px-4 py-2 bg-blue-600 text-white rounded-lg text-center"
      >
        Contact
      </button>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const setMenu = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    menuBtn?.setAttribute("aria-expanded", String(open));
  };
  menuBtn?.addEventListener("click", () => setMenu(menu?.classList.contains("hidden") ?? false));
  // Close after choosing a destination
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
</script>
