---
import Section from "./Section.astro";
import skills from "../data/skills.json";
---

<Section id="skills" title="Skills">
  <div class="grid md:grid-cols-2 gap-8">
    {
      skills.map((s) => (
        <div class:list={["p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition", s.wide && "md:col-span-2"]}>
          <h3 class="font-semibold mb-3 text-blue-600 dark:text-blue-400">{s.title}</h3>
          <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{s.text}</p>
        </div>
      ))
    }
  </div>
</Section>
