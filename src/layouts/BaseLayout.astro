---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import PdfModal from "../components/PdfModal.astro";
import ContactPanel from "../components/ContactPanel.astro";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const siteName = "Vivek Kumar";
const {
  title,
  description = "Vivek Kumar — researcher working on data science, machine learning, remote sensing and quantitative finance.",
  type = "website",
} = Astro.props;

const fullTitle = title ? `${title} | ${siteName}` : `${siteName} | Research Portfolio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Blog`} href="/rss.xml" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
    />

    <!-- Apply saved/system theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-paper text-gray-800 dark:bg-gray-900 dark:text-gray-200 transition-colors">
    <Header />
    <Sidebar />
    <div class="xl:pl-64">
      <main class="pt-16 xl:pt-0">
        <slot />
      </main>
      <Footer />
    </div>
    <PdfModal />
    <ContactPanel />

    <script>
      // Header and sidebar each render a toggle; only one is visible at a time
      document.querySelectorAll("[data-theme-toggle]").forEach((btn) =>
        btn.addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          try {
            localStorage.setItem("theme", dark ? "dark" : "light");
          } catch {}
        }),
      );

      // Email links carry a base64 address and only become mailto: when clicked
      document.addEventListener("click", (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>("a[data-email]");
        if (!link?.dataset.email) return;
        e.preventDefault();
        window.location.href = `mailto:${atob(link.dataset.email)}`;
      });
    </script>
  </body>
</html>
